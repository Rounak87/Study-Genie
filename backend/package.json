{
  "name": "study-genie-backend",
  "version": "1.0.0",
  "description": "Backend API for Study-Genie AI learning platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:node": "nodemon server.js",
    "start:python": "cd python && .venv\\Scripts\\python -m uvicorn main:app --host 127.0.0.1 --port 8000",
    "dev": "concurrently \"npm run start:node\" \"npm run start:python\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1078.0",
    "@aws-sdk/s3-request-presigner": "^3.1078.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.2"
  }
}
